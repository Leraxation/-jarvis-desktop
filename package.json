{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "JARVIS — Personal AI Desktop Assistant",
  "main": "main.js",
  "scripts": {
    "dev":     "vite",
    "build":   "vite build",
    "start":   "electron .",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.lerax.jarvis",
    "productName": "JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "electron": "^30.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.0"
  }
}
